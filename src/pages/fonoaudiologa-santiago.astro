---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import { socials } from "../data/socials";

const title = "Fonoaudióloga en Santiago | SocialKids - Terapia a Domicilio";
const description = "Francisca Veloso, fonoaudióloga en Santiago. Terapias fonoaudiológicas a domicilio para niños con trastornos del lenguaje, habla y voz. Especializada en autismo y síndrome de Down.";

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿La fonoaudióloga en Santiago atiende a domicilio?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sí, Francisca Veloso atiende a domicilio en Santiago. Se traslada al hogar del niño/a para que la terapia se realice en un ambiente familiar y cómodo." }
    },
    {
      "@type": "Question",
      "name": "¿Qué terapias fonoaudiológicas ofrece en Santiago?",
      "acceptedAnswer": { "@type": "Answer", "text": "Terapia de lenguaje, habla (dislalia), voz, evaluaciones fonoaudiológicas, atención para autismo (TEA) y síndrome de Down, todas a domicilio en Santiago." }
    },
    {
      "@type": "Question",
      "name": "¿Desde qué edad pueden atenderse los niños en Santiago?",
      "acceptedAnswer": { "@type": "Answer", "text": "Atendemos niños desde los 2 años. La evaluación inicial a domicilio permite conocer las necesidades de tu hijo/a y definir el plan de terapia." }
    },
    {
      "@type": "Question",
      "name": "¿Cómo agendar una sesión de fonoaudiología a domicilio en Santiago?",
      "acceptedAnswer": { "@type": "Answer", "text": "Puedes agendar por WhatsApp al +56 9 7962 7693 o escribirnos a contacto@socialkids.cl. La primera sesión es una evaluación a domicilio para conocer las necesidades de tu hijo/a." }
    }
  ]
});

const lbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "SocialKids - Fonoaudióloga en Santiago",
  "url": "https://socialkids.cl/fonoaudiologa-santiago",
  "telephone": "+56979627693",
  "address": { "@type": "PostalAddress", "addressLocality": "Santiago", "addressRegion": "Región Metropolitana", "addressCountry": "CL" },
  "areaServed": [
    { "@type": "City", "name": "Santiago" },
    { "@type": "State", "name": "Región Metropolitana" },
    { "@type": "Country", "name": "Chile" }
  ],
  "employee": { "@type": "Person", "name": "Francisca Veloso Vega", "jobTitle": "Fonoaudióloga" }
});

const services = [
  { icon: "🏠", title: "Atención a Domicilio", desc: "Nos trasladamos al hogar del niño/a en Santiago para que la terapia ocurra en su propio ambiente." },
  { icon: "🗣️", title: "Trastornos del Lenguaje", desc: "Evaluación y tratamiento de retrasos en el lenguaje comprensivo y expresivo." },
  { icon: "🔊", title: "Trastornos del Habla", desc: "Dislalia, tartamudez y problemas de pronunciación corregidos con técnicas innovadoras." },
  { icon: "🧩", title: "Autismo (TEA)", desc: "Intervención fonoaudiológica para niños con Trastorno del Espectro Autista." },
  { icon: "💙", title: "Síndrome de Down", desc: "Estimulación del lenguaje y comunicación adaptada." },
  { icon: "📋", title: "Evaluaciones Fonoaudiológicas", desc: "Evaluación completa a domicilio para determinar el plan de terapia de tu hijo/a." },
];

const faqs = [
  { q: "¿La fonoaudióloga en Santiago atiende a domicilio?", a: "Sí, Francisca Veloso atiende a domicilio en Santiago. Se traslada al hogar del niño/a para que la terapia sea en un ambiente familiar y cómodo." },
  { q: "¿Qué terapias ofrece la fonoaudióloga en Santiago?", a: "Lenguaje, habla (dislalia), voz, autismo (TEA), síndrome de Down y evaluaciones, todas a domicilio en Santiago." },
  { q: "¿Desde qué edad atienden en Santiago?", a: "Desde los 2 años. La primera sesión es una evaluación a domicilio para conocer las necesidades de tu hijo/a." },
  { q: "¿Cómo agendar una sesión en Santiago?", a: "Por WhatsApp al +56 9 7962 7693 o escribiendo a contacto@socialkids.cl." },
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
    <script type="application/ld+json" set:html={lbSchema} />
  </Fragment>

  <main class="flex flex-col gap-y-16 md:gap-y-24 overflow-hidden">

    <!-- HERO -->
    <section class="relative pt-32 lg:pt-36 pb-10">
      <span class="w-4/12 lg:w-2/12 aspect-square bg-gradient-to-tr from-primary to-green-400 absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"></span>
      <Container className={"flex flex-col lg:flex-row gap-10 lg:gap-12"}>
        <div class="relative flex flex-col items-center text-center lg:text-left lg:py-7 lg:items-start lg:max-w-none max-w-3xl mx-auto lg:mx-0 lg:flex-1 lg:w-1/2">
          <nav class="text-sm text-heading-3 mb-4 w-full" aria-label="breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Inicio</a>
            <span class="mx-2">›</span>
            <span class="text-primary font-medium">Santiago</span>
          </nav>

          <h1 class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight xl:text-6xl/tight font-bold text-heading-1 pt-4">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-600 to-pink-600">Fonoaudióloga</span>
            {" "}en Santiago
          </h1>

          <p class="mt-8 text-heading-3 text-lg leading-relaxed max-w-xl">
            Terapias fonoaudiológicas <strong>a domicilio</strong> para niños en Santiago. Nos trasladamos a tu hogar para que tu hijo/a reciba atención en su propio ambiente. Especializada en lenguaje, habla, autismo y síndrome de Down.
          </p>

          <!-- Badge domicilio -->
          <div class="mt-5 inline-flex items-center gap-2 bg-fuchsia-50 dark:bg-fuchsia-900/30 text-fuchsia-700 dark:text-fuchsia-400 text-sm font-semibold px-4 py-2 rounded-full border border-fuchsia-200 dark:border-fuchsia-800">
            <span class="w-2 h-2 rounded-full bg-fuchsia-500 animate-pulse"></span>
            Atención a domicilio en Santiago
          </div>

          <div class="mt-8 w-full flex max-w-md mx-auto lg:mx-0">
            <div class="flex sm:flex-row flex-col gap-4 w-full">
              <a href={socials[2].url} target="_blank" id="cta-whatsapp-stgo"
                class="flex-1 flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold py-3 px-5 rounded-full transition-colors duration-200 shadow-lg shadow-green-200">
                📲 Agendar por WhatsApp
              </a>
              <a href="mailto:contacto@socialkids.cl" id="cta-email-stgo"
                class="flex-1 flex items-center justify-center gap-2 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold py-3 px-5 rounded-full transition-all duration-200">
                ✉️ Consultar por correo
              </a>
            </div>
          </div>
        </div>

        <div class="flex flex-1 lg:w-1/2 lg:h-auto relative lg:max-w-none lg:mx-0 mx-auto max-w-3xl">
          <img src="/images/children-playing2.webp"
            alt="Fonoaudióloga atendiendo niño a domicilio en Santiago"
            width="1240" height="1385"
            class="lg:absolute lg:w-full lg:h-full rounded-3xl object-cover lg:max-h-none max-h-100" />
        </div>
      </Container>
    </section>

    <!-- ¿CÓMO FUNCIONA? -->
    <section id="como-funciona-stgo">
      <Container>
        <h2 class="text-3xl font-bold text-heading-1 text-center mb-4">¿Cómo funciona la terapia a domicilio en Santiago?</h2>
        <p class="text-heading-3 text-center max-w-2xl mx-auto mb-12">Tres pasos simples para que tu hijo/a empiece a mejorar su comunicación en casa.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          {[
            { step: "01", icon: "📲", title: "Contáctanos", desc: "Escríbenos por WhatsApp o correo para coordinar la primera sesión de evaluación a domicilio." },
            { step: "02", icon: "🏠", title: "Evaluación en casa", desc: "Primera visita a domicilio para evaluar al niño/a y definir el plan de terapia personalizado." },
            { step: "03", icon: "🎯", title: "Terapia personalizada", desc: "Sesiones semanales en el hogar con seguimiento continuo y reporte de avances a la familia." },
          ].map(s => (
            <div class="relative bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-sm border border-box-border text-center">
              <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-fuchsia-600 to-pink-600 text-white text-xs font-bold px-3 py-1 rounded-full">{s.step}</span>
              <div class="text-4xl mb-4 mt-2">{s.icon}</div>
              <h3 class="font-bold text-heading-2 mb-2">{s.title}</h3>
              <p class="text-sm text-heading-3 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios-stgo">
      <Container>
        <h2 class="text-3xl font-bold text-heading-1 text-center mb-4">Terapias fonoaudiológicas a domicilio en Santiago</h2>
        <p class="text-heading-3 text-center max-w-2xl mx-auto mb-12">Atención especializada a domicilio para niños en toda la Región Metropolitana. Nos trasladamos a tu hogar.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.map(s => (
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-box-border hover:shadow-md hover:border-primary transition-all duration-200">
              <div class="text-3xl mb-3">{s.icon}</div>
              <h3 class="font-bold text-heading-2 mb-2">{s.title}</h3>
              <p class="text-sm text-heading-3 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- FAQ -->
    <section id="faq-stgo" class="pb-10">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold text-heading-1 text-center mb-10">Preguntas frecuentes – Fonoaudióloga en Santiago</h2>
          <div class="space-y-4">
            {faqs.map(faq => (
              <details class="group bg-white dark:bg-gray-800 rounded-2xl border border-box-border overflow-hidden">
                <summary class="flex justify-between items-center cursor-pointer p-6 font-semibold text-heading-2 list-none select-none hover:text-primary transition-colors">
                  {faq.q}
                  <span class="ml-4 text-xl transition-transform group-open:rotate-45 flex-shrink-0">+</span>
                </summary>
                <p class="px-6 pb-6 text-heading-3 leading-relaxed">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <!-- ENLACE A PUERTO VARAS -->
    <section class="pb-4">
      <Container>
        <div class="bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <p class="text-sm text-heading-3 font-medium">¿Estás en Puerto Varas o alrededores?</p>
            <p class="text-heading-2 font-bold">También atendemos a domicilio en la región de Los Lagos</p>
          </div>
          <a href="/fonoaudiologa-puerto-varas" id="link-puerto-varas-from-stgo"
            class="flex-shrink-0 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold py-2 px-6 rounded-full transition-all duration-200">
            Ver Puerto Varas →
          </a>
        </div>
      </Container>
    </section>

    <!-- CTA FINAL -->
    <section class="pb-20">
      <Container>
        <div class="text-center bg-gradient-to-tr from-fuchsia-600 to-pink-600 rounded-3xl p-10 md:p-16">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">¿Lista para empezar en Santiago?</h2>
          <p class="text-fuchsia-100 text-lg mb-8 max-w-xl mx-auto">Primera sesión de evaluación a domicilio en Santiago. Sin filas ni desplazamientos de tu parte.</p>
          <a href={socials[2].url} target="_blank" id="cta-final-stgo"
            class="inline-flex items-center gap-2 bg-white text-fuchsia-700 hover:bg-fuchsia-50 font-bold py-4 px-8 rounded-full transition-colors duration-200 text-lg shadow-xl">
            Agendar ahora por WhatsApp →
          </a>
        </div>
      </Container>
    </section>

  </main>
</Layout>
