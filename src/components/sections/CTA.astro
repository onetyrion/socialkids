---
// import Button from "../shared/Button.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
---

<section id="cta" class="pb-20">
  <Container>
    <div
      class="w-full overflow-hidden relative py-8 md:py-10 px-6 md:px-8 rounded-2xl bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900"
    >
      <div class="absolute right-0 top-0 h-full w-full flex justify-end">
        <div
          class="w-full h-full overflow-hidden flex rounded-xl relative blur-2xl"
        >
          <span
            class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
          ></span>
        </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
        <div
          class="w-full h-full overflow-hidden flex rounded-xl relative blur-2xl"
        >
          <span
            class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
          ></span>
          <span
            class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
          ></span>
        </div>
      </div>

      <div class="mx-auto text-center max-w-3xl relative">
        <h2
          class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight
          font-bold text-heading-1"
        >
          <span
            class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600"
            >¿Dónde atendemos?</span
          >
        </h2>
        <Paragraph className={"pt-6 mb-8"}>
          Ofrecemos terapias fonoaudiológicas especializadas para niños en dos ciudades.
          Selecciona tu ciudad para más información.
        </Paragraph>

        <!-- City cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-4 text-left">
          <!-- Puerto Varas card -->
          <a
            href="/fonoaudiologa-puerto-varas"
            id="city-card-puerto-varas"
            class="group relative bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md border border-box-border hover:border-primary hover:shadow-lg transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div class="text-3xl">🏔️</div>
              <div>
                <h3 class="font-bold text-lg text-heading-1 group-hover:text-primary transition-colors">Puerto Varas</h3>
                <p class="text-sm text-heading-3 mt-1">Terapia <strong>a domicilio</strong> en Puerto Varas, Puerto Montt, Frutillar, Llanquihue y alrededores.</p>
              </div>
            </div>
            <div class="mt-4 text-sm font-semibold text-primary flex items-center gap-1">
              Ver más <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>

          <!-- Santiago card -->
          <a
            href="/fonoaudiologa-santiago"
            id="city-card-santiago"
            class="group relative bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md border border-box-border hover:border-primary hover:shadow-lg transition-all duration-300"
          >
            <div class="flex items-start gap-4">
              <div class="text-3xl">🏙️</div>
              <div>
                <h3 class="font-bold text-lg text-heading-1 group-hover:text-primary transition-colors">Santiago</h3>
                <p class="text-sm text-heading-3 mt-1">Terapia <strong>a domicilio</strong> para niños en Santiago y toda la Región Metropolitana.</p>
              </div>
            </div>
            <div class="mt-4 text-sm font-semibold text-primary flex items-center gap-1">
              Ver más <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>

